<Window x:Class="Nte.LoginHost.RegionSwitchWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="660" MinWidth="520" Height="430" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding TargetName}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding InstallationPath}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="DimGray" />
            <TextBlock Text="{Binding Hint}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="8" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Detail}" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="DimGray"
                       MaxHeight="65" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="0,16,0,12" TextWrapping="Wrap" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" Padding="16,9" Margin="0,0,8,0" />
            <Button Content="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" Padding="16,9" Margin="0,0,8,0"
                    IsDefault="True" />
            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Padding="16,9" />
        </StackPanel>
    </Grid>
</Window>
