<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Nte.LoginHost</AssemblyName>
    <RootNamespace>Nte.LoginHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Configurations>Debug;Release;DebugNoReflection;ReleaseNoReflection</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Hi3Helper.Plugin.NTE.SdkShared/**/*.cs" Link="Sdk/%(Filename)%(Extension)"/>
    <Compile Include="../Hi3Helper.Plugin.NTE/Management/Game/NteProcessImage.cs" Link="Launch/NteProcessImage.cs"/>
    <Page Remove="ThirdParty/Collapse/*.xaml"/>
    <Content Include="Assets/*.png" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Assets/Brand/*.png;Assets/Brand/*.txt;Assets/Brand/*.json" CopyToOutputDirectory="PreserveNewest"/>
    <Resource Include="Assets/Brand/*.ttf"/>
    <Content Include="ThirdParty/Collapse/LICENSE" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="ThirdParty/Collapse/UPSTREAM.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="ThirdParty/Collapse/*.xaml" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
